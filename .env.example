# Copy to .env and adjust. .env is gitignored.

# Binance public market data (no API key needed)
BINANCE_WS_BASE=wss://stream.binance.com:9443
SYMBOLS=btcusdt,ethusdt
DEPTH_INTERVAL_MS=100

# Raw frame archive (hourly files, gzipped when the hour ends)
RAW_DIR=data/raw

# Prometheus metrics endpoint served by the consumer
METRICS_ADDR=127.0.0.1
METRICS_PORT=8000

# Postgres / TimescaleDB (also read by docker-compose)
PGHOST=localhost
PGPORT=5432
PGUSER=tickwatch
PGPASSWORD=change-me
PGDATABASE=tickwatch
